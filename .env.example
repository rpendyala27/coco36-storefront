# Copy to .env.local — never commit secrets

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Razorpay client-side key (publishable; never put secret in Vite) ────────
VITE_RAZORPAY_KEY_ID=rzp_test_...

# ── Next.js admin/API endpoint ───────────────────────────────────────────────
# Local dev: http://localhost:3001
# Prod:      https://coco36-next.vercel.app (or https://admin.coco36.com)
VITE_API_URL=https://coco36-next.vercel.app

# ── Google Analytics 4 ──────────────────────────────────────────────────────
# Optional. Defaults to the production property if unset. Analytics only loads
# after the visitor accepts in the cookie banner, and only in prod builds.
VITE_GA_MEASUREMENT_ID=G-H2E318VXJX
# Set to true to also send from `npm run dev` (off by default so local traffic
# never pollutes the production property).
# VITE_GA_DEV=true

# No server secrets here: every VITE_* value is compiled into the public
# bundle. AI keys (Coco AI, Phase 3) belong to the admin API (coco36-next).
APP_URL=http://localhost:3000

# ── IndexNow (server-only; Vercel Production) ───────────────────────────────
# Do not commit a value. Do not use a VITE_* name: those are compiled into the
# public bundle. Generate with: openssl rand -hex 16
# Leave empty for Preview, local, and CI. The key file is 404 and nothing pings.
INDEXNOW_KEY=
# Optional. When set, POST /api/indexnow-submit also accepts Authorization: Bearer <this>.
INDEXNOW_SUBMIT_SECRET=

# ── Back-in-stock alerts (server-only; leave unset until Rohan says yes) ──
# Never use a VITE_* name. Unset or any value other than the exact string
# true means no restock email is sent, including on Preview.
# RESTOCK_EMAIL_ENABLED=true
RESTOCK_EMAIL_ENABLED=
# Resend API key. Required only after the flag above is turned on.
RESEND_API_KEY=
# Optional From override. When empty, mail uses COCO36 <support@coco36.com>.
# This app does not set Reply-To.
RESTOCK_EMAIL_FROM=
# Bearer for GET /api/notify-export and POST /api/restock-alerts.
# Unset (and no NOTIFY_ADMIN_EMAILS) makes both routes 404.
NOTIFY_EXPORT_SECRET=
# Optional. Comma-separated Supabase auth emails that may also download the CSV.
NOTIFY_ADMIN_EMAILS=
# Service role. Reads and the sent-flag update only. Never put this in a VITE_* var.
SUPABASE_SERVICE_ROLE_KEY=
