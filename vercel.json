{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": ["sin1"],
  "trailingSlash": false,
  "functions": {
    "api/render.ts": { "includeFiles": "dist-server/index.html", "maxDuration": 10 },
    "api/sitemap.ts": { "maxDuration": 10 },
    "api/indexnow-key.ts": { "maxDuration": 10 },
    "api/indexnow-submit.ts": { "maxDuration": 10 },
    "api/notify.ts": { "maxDuration": 10 },
    "api/notify-export.ts": { "maxDuration": 10 },
    "api/restock-alerts.ts": { "maxDuration": 10 }
  },
  "redirects": [
    {
      "source": "/shop/bean-to-bar-kit",
      "has": [{ "type": "host", "value": "www.coco36.com" }],
      "destination": "https://coco36.com/shop",
      "statusCode": 301
    },
    {
      "source": "/shop/bean-to-bar-kit/",
      "has": [{ "type": "host", "value": "www.coco36.com" }],
      "destination": "https://coco36.com/shop",
      "statusCode": 301
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.coco36.com" }],
      "destination": "https://coco36.com/:path",
      "statusCode": 301
    },
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/shop/bean-to-bar-kit", "destination": "/shop", "statusCode": 301 },
    { "source": "/shop/bean-to-bar-kit/", "destination": "/shop", "statusCode": 301 },
    { "source": "/catalog", "destination": "/shop", "statusCode": 301 },
    { "source": "/traceability", "destination": "/36-steps", "statusCode": 301 },
    { "source": "/cms", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/:file.txt", "destination": "/api/indexnow-key?file=:file" },
    { "source": "/(.*)", "destination": "/api/render?__path=$1" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
